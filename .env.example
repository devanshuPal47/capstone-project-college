# Copy to .env and fill in your own values before running with AI/Supabase.

# Generative AI (optional — app works without this via deterministic fallback)
GEN_AI_API_KEY=your_generative_ai_api_key_here
GEN_AI_ENDPOINT=https://api.example.com/v1/generate-itinerary

# Supabase (optional — trip saving degrades gracefully if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
