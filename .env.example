# Copy to .env and fill in your own values before running with AI/Supabase.

# --- Generative AI (Gemini) ---
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Legacy generic AI (optional)
GEN_AI_API_KEY=
GEN_AI_ENDPOINT=

# --- Supabase (optional - trip persistence) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Direct PostgreSQL via Supabase Session Pooler (optional) ---
# Format: postgresql://postgres.vlwcebyblkbjpiaflljr:<YOUR_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.vlwcebyblkbjpiaflljr:<YOUR_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
